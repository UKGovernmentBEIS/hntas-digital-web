{
  "name": "hntas.web.ui",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "copy:govuk-assets": "cpx \"node_modules/govuk-frontend/dist/govuk/assets/**/*\" \"assets\"",
    "sass": "sass assets/scss/main.scss:wwwroot/assets/css/main.css",
    "minify": "postcss wwwroot/assets/css/main.css -o wwwroot/assets/css/main.min.css",
    "build-css": "npm run sass && npm run minify",
    "sass:watch": "sass --watch src/styles:public/styles",
    "build-js": "webpack --mode production",
    "watch-js": "webpack --watch --mode development"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "accessible-autocomplete": "^3.0.1",
    "chokidar": "^3.6.0",
    "govuk-frontend": "^5.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.24.5",
    "@ministryofjustice/frontend": "^5.2.1",
    "babel-loader": "^9.1.3",
    "cpx": "^1.5.0",
    "css-loader": "^7.1.1",
    "cssnano": "^7.0.1",
    "file-loader": "^6.2.0",
    "mini-css-extract-plugin": "^2.9.0",
    "postcss": "^8.5.10",
    "postcss-cli": "^11.0.0",
    "sass": "1.77.0",
    "sass-loader": "^14.2.1",
    "style-loader": "^4.0.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "overrides": {
    "shell-quote": "^1.8.4",
    "immutable": "^4.3.8",
    "minimatch": "^3.1.4",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "serialize-javascript": "^7.0.5",
    "braces": "^3.0.3",
    "svgo": "^3.3.5",
    "fast-uri": "^3.1.2",
    "picomatch": "^2.3.2",
    "brace-expansion": "^1.1.13",
    "ajv": "^8.18.0",
    "micromatch": "^4.0.8",
    "yaml": "^2.8.3"
  }
}
