@model HNTAS.Web.UI.Models.HeatNetworkRegistration.HeatNetworkConnectionsViewModel

@{
    ViewData["Title"] = "What connections does this heat network have?";

    var hasConnectionsError = ViewData.ModelState["Connections"]?.Errors.Count > 0;
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

        <span class="govuk-caption-l">Add a heat network</span>
        <form asp-action="HeatNetworkConnections" asp-controller="HeatNetworkRegistration" method="post" aria-describedby="connections-error">
            <div class="govuk-form-group @(hasConnectionsError ? "govuk-form-group--error" : "")">
                <fieldset class="govuk-fieldset">

                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
                        <h1 class="govuk-fieldset__heading">
                            What connections does this heat network have?
                        </h1>
                    </legend>

                    <div id="heat-network-connections-hint" class="govuk-hint">
                        <p class="govuk-body govuk-!-margin-bottom-2">Include communal buildings, not the individual homes or units inside them</p>Select all that apply
                    </div>

                    @if (hasConnectionsError)
                    {
                        <p id="connections-error" class="govuk-error-message">
                            <span class="govuk-visually-hidden">Error:</span>
                            @Html.ValidationMessage("Connections")
                        </p>
                    }

                    <div class="govuk-checkboxes" data-module="govuk-checkboxes">

                        @for (int i = 0; i < Model.Connections.Count; i++)
                        {
                            var item = Model.Connections[i];
                            var itemId = i == 0 ? "connections" : $"connections-{i}";
                            var conditionalId = $"conditional-{i}";
                            var itemErrorKey = $"Connections[{i}].ConditionalValue";
                            var hasItemError = ViewData.ModelState[itemErrorKey]?.Errors.Count > 0;
                            var inputId = $"connections[{i}].conditionalvalue";

                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input"
                                       type="checkbox"
                                       id="@itemId"
                                       asp-for="Connections[i].IsSelected"
                                       data-aria-controls="@conditionalId" />

                                <label class="govuk-label govuk-checkboxes__label"
                                       for="@itemId">
                                    @item.Label
                                </label>

                                @if (!string.IsNullOrEmpty(item.HintText))
                                {
                                    <div class="govuk-hint govuk-checkboxes__hint">
                                        @item.HintText
                                    </div>
                                }
                            </div>

                            <!-- Conditional input -->
                            <div id="@conditionalId" class="govuk-checkboxes__conditional @(item.IsSelected ? "" : "govuk-checkboxes__conditional--hidden")">

                                <div class="govuk-form-group @(hasItemError ? "govuk-form-group--error" : "")">

                                    <label class="govuk-label">
                                        @item.ConditionalLabel
                                    </label>

                                    @if (hasItemError)
                                    {
                                        <p class="govuk-error-message">
                                            <span class="govuk-visually-hidden">Error:</span>
                                            @ViewData.ModelState[itemErrorKey].Errors.First().ErrorMessage
                                        </p>
                                    }

                                    <input class="govuk-input govuk-input--width-3 @(hasItemError ? "govuk-input--error" : "")"
                                           type="number"
                                           asp-for="Connections[i].ConditionalValue"
                                           id="@inputId"
                                           min="1"
                                           max="9999" />
                                </div>
                            </div>
                        }

                    </div>
                </fieldset>

            </div>

            <button class="govuk-button" type="submit">
                Continue
            </button>
        </form>

    </div>
</div>