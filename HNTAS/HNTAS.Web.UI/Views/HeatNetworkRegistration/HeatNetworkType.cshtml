@using HNTAS.Web.UI.Models
@using HNTAS.Web.UI.Models.HeatNetworkRegistration
@using HNTAS.Web.UI.Models.Enums
@model IsHnTypeCommunalViewModel

@{
    ViewData["Title"] = "Network Type – Certify your heat networks with the Heat Network Technical Assurance Scheme (HNTAS)";
    var fieldOrder = new[] { nameof(Model.IsHnTypeCommunal) };
    var elementId = Html.GenerateIdFromName(nameof(Model.IsHnTypeCommunal)).ToLowerInvariant();
    var pageData = new QuestionWithRadiobuttonsModel
    {
        Controller = "HeatNetworkRegistration",
        Action = "HeatNetworkType",
        FieldOrder = fieldOrder,
        Questions = new List<Question>
        {
            new Question
            {
                QId = elementId,
                QText = "What type of network do you want to register?",
                HeadingLevel = QuestionHeadingLevel.H2,
                QDescText = null,
                QHintText = null,
                Options = new List<Option>
                {
                    new Option { OptId = $"{elementId}", OptValue = "true", OptText = "Communal", OptHintText = null },
                    new Option { OptId = $"{elementId}-2", OptValue = "false", OptText = "District", OptHintText = null }
                },
                SeletedOption = Model.IsHnTypeCommunal.ToString().ToLowerInvariant()
            },
        }
    };
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <span class="govuk-caption-l">Add a heat network</span>
            <h1 class="govuk-heading-l">
                Network type
            </h1>
            <p class="govuk-body">Register each communal and district heat network separately. Only register heat networks your organisation owns.</p>
            @await Html.PartialAsync("_QuestionWithRadiobuttons", pageData)
        </div>
    </div>
</div>