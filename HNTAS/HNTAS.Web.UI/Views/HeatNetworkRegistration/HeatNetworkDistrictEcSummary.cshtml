@using HNTAS.Web.UI.Models.HeatNetworkRegistration
@using HNTAS.Api.Client.Model
@model HeatNetworkConnectionsViewModel

@{
    ViewData["Title"] = "Heat network summary";    
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <span class="govuk-caption-l">Add a heat network</span>
        <h1 class="govuk-heading-l">
            Heat network summary
        </h1>
        <p class="govuk-body">You're registering a district heat network with its own main energy centre.</p>
        <p class="govuk-body">Any communal networks conneted to this district network must be registerd separately.</p>

        <h2 class="govuk-heading-m">Connections</h2>

        <ul class="govuk-list govuk-list--bullet">
            @if (Model.ConnectionsToDisplay.Any())
            {
                foreach (var c in Model.ConnectionsToDisplay)
                {
                    <li>@c</li>
                }
            }
        </ul>

        <button class="govuk-button" onclick="location.href='@Url.Action("HeatNetworkName", "HeatNetworkRegistration")'">
            Continue
        </button>
    </div>
</div>