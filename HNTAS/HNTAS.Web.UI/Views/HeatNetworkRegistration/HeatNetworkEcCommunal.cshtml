@using HNTAS.Web.UI.Models
@using HNTAS.Web.UI.Models.HeatNetworkRegistration
@using HNTAS.Web.UI.Models.Enums
@model DoesCommunalHnHaveOwnEcViewModel

@{
    ViewData["Title"] = "Energy centre – Certify your heat networks with the Heat Network Technical Assurance Scheme (HNTAS)";
    var fieldOrder = new[] { nameof(Model.HasOwnEc) };
    var elementId = Html.GenerateIdFromName(nameof(Model.HasOwnEc)).ToLowerInvariant();
    var pageData = new QuestionWithRadiobuttonsModel
    {
        Controller = "HeatNetworkRegistration",
        Action = "HeatNetworkEcCommunal",
        FieldOrder = fieldOrder,
        Questions = new List<Question>
        {
            new Question
            {
                QId = elementId,
                QText = "Does this heat network have its own energy centre?",
                QDescText = null,
                QHintText = null,
                Options = new List<Option>
                {
                    new Option { OptId = $"{elementId}", OptValue = "true", OptText = "Yes", OptHintText = null },
                    new Option { OptId = $"{elementId}-2", OptValue = "false", OptText = "No, it is supplied by another network", OptHintText = null }
                },
                SeletedOption = Model.HasOwnEc.ToString().ToLowerInvariant()
            },
        }
    };
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <span class="govuk-caption-l">Add a heat network</span>
            <h1 class="govuk-heading-l">
                Energy centre
            </h1>
            <p class="govuk-body">The energy centre is a plant room that contains heat generation equipment and/or equipment connecting to an energy source. It may be in the building or located nearby.</p>
            @await Html.PartialAsync("_QuestionWithRadiobuttons", pageData)
        </div>
    </div>
</div>