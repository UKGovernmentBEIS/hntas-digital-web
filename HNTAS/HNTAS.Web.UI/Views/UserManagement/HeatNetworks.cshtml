@using HNTAS.Web.UI.Models
@model HeatNetworksViewModel

@{
    ViewData["Title"] = "Heat networks";

    string GetNextDirection(string column)
    {
        if (Model.SortBy.Equals(column, StringComparison.OrdinalIgnoreCase))
        {
            return Model.SortDirection == "asc" ? "desc" : "asc";
        }
        return "asc";
    }

    string GetAriaSort(string column)
    {
        if (Model.SortBy.Equals(column, StringComparison.OrdinalIgnoreCase))
        {
            return Model.SortDirection == "asc" ? "ascending" : "descending";
        }
        return "none";
    }

    string GetSortUrl(string column)
    {
        return Url.Action("HeatNetworks", "UserManagement", new
        {
            pageNumber = Model.PageNumber,
            pageSize = Model.PageSize,
            sortBy = column,
            sortDirection = GetNextDirection(column)
        }) ?? "#";
    }

    Microsoft.AspNetCore.Html.IHtmlContent GetSortIcon(string column)
    {
        if (Model.SortBy.Equals(column, StringComparison.OrdinalIgnoreCase))
        {
            if (Model.SortDirection == "asc")
            {
                return Html.Raw("<svg class='govuk-!-margin-left-1' width='12' height='12' viewBox='0 0 12 12' fill='none' xmlns='http://www.w3.org/2000/svg' aria-hidden='true' focusable='false'><path d='M6 2L10 8H2L6 2Z' fill='currentColor'/></svg>");
            }
            else
            {
                return Html.Raw("<svg class='govuk-!-margin-left-1' width='12' height='12' viewBox='0 0 12 12' fill='none' xmlns='http://www.w3.org/2000/svg' aria-hidden='true' focusable='false'><path d='M6 10L2 4H10L6 10Z' fill='currentColor'/></svg>");
            }
        }
        return Html.Raw(string.Empty);
    }
}

@section BeforeMain {
    <nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
        <ol class="govuk-breadcrumbs__list">
            <li class="govuk-breadcrumbs__list-item">
                <a class="govuk-breadcrumbs__link" href="@Url.Action("UserAccount", "Dashboard")">Dashboard</a>
            </li>
            <li class="govuk-breadcrumbs__list-item">
                Heat networks
            </li>
        </ol>
    </nav>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

        <h1 class="govuk-heading-l">Heat networks</h1>
        
        @if (Model.IsResponsiblePerson || Model.IsHntasCoordinator)
        {
            <p class="govuk-!-margin-top-6">
                <a role="button" draggable="false" class="govuk-button" data-module="govuk-button" asp-controller="HeatNetwork" asp-action="Index">
                    Add a new heat network
                </a>
            </p>
        }
        <table class="govuk-table">
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header" aria-sort="@GetAriaSort("OrganisationName")">
                        <a class="govuk-link govuk-link--no-visited-state" href="@GetSortUrl("OrganisationName")">
                            Organisation @GetSortIcon("OrganisationName")
                        </a>
                    </th>
                    <th scope="col" class="govuk-table__header" aria-sort="@GetAriaSort("Name")">
                        <a class="govuk-link govuk-link--no-visited-state" href="@GetSortUrl("Name")">
                            Heat network @GetSortIcon("Name")
                        </a>
                    </th>
                    <th scope="col" class="govuk-table__header" aria-sort="@GetAriaSort("Role")">
                        <a class="govuk-link govuk-link--no-visited-state" href="@GetSortUrl("Role")">
                            Your Role @GetSortIcon("Role")
                        </a>
                    </th>
                    <th scope="col" class="govuk-table__header">Action</th>
                    @if (ViewBag.IsRegistrationEnabled == true)
                    {
                        <th scope="col" class="govuk-table__header">Certification history</th>
                    }
                </tr>
            </thead>

            <tbody class="govuk-table__body">
                @if (Model.HeatNetworks != null && Model.HeatNetworks.Any())
                {
                    @foreach (var heatNetwork in Model.HeatNetworks)
                    {
                        <tr class="govuk-table__row">
                            <td class="govuk-table__cell">@heatNetwork.OrganisationName</td>
                            <td class="govuk-table__cell">
                                @heatNetwork.HnId<br />
                                @heatNetwork.Name<br />
                                @if (!string.IsNullOrWhiteSpace(heatNetwork.HnDescription))
                                {
                                    <span class="govuk-hint govuk-!-margin-bottom-0">@heatNetwork.HnDescription</span>
                                }
                            </td>
                            <td class="govuk-table__cell">@heatNetwork.Role</td>
                            <td class="govuk-table__cell">
                                <a class="govuk-link govuk-link--no-visited-state" href="@Url.Action("PrepareToAddNetworkDetails", "HeatNetwork", new { hnId = heatNetwork.HnId })">
                                    Add network details
                                </a>
                            </td>
                            @if (ViewBag.IsRegistrationEnabled == true)
                            {
                                <td class="govuk-table__cell">
                                    <a class="govuk-link govuk-link--no-visited-state" href="@Url.Action("Index", "AuditHistory", new { hnId = heatNetwork.HnId })">
                                        View
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell" colspan="@(ViewBag.IsRegistrationEnabled == true ? 5 : 4)">
                            No heat networks found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.TotalPages > 1)
        {
            <nav class="govuk-pagination" role="navigation" aria-label="Pagination">
                @if (Model.HasPreviousPage)
                {
                    <div class="govuk-pagination__prev">
                        <a class="govuk-link govuk-pagination__link" href="@Url.Action("HeatNetworks", "UserManagement", new { pageNumber = Model.PageNumber - 1, pageSize = Model.PageSize, sortBy = Model.SortBy, sortDirection = Model.SortDirection })" rel="prev">
                            <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                                <path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.1856-3.9768h12.896v-2h-12.984l4.2931-4.293-1.414-1.414z"></path>
                            </svg>
                            <span class="govuk-pagination__link-title">Previous</span>
                        </a>
                    </div>
                }

                <ul class="govuk-pagination__list">
                    @{
                        int startPage = Math.Max(1, Model.PageNumber - 2);
                        int endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);

                        for (int i = startPage; i <= endPage; i++)
                        {
                            if (i == Model.PageNumber)
                            {
                                <li class="govuk-pagination__item govuk-pagination__item--current">
                                    <a class="govuk-link govuk-pagination__link" href="#" aria-label="Page @i" aria-current="page">@i</a>
                                </li>
                            }
                            else
                            {
                                <li class="govuk-pagination__item">
                                    <a class="govuk-link govuk-pagination__link" href="@Url.Action("HeatNetworks", "UserManagement", new { pageNumber = i, pageSize = Model.PageSize, sortBy = Model.SortBy, sortDirection = Model.SortDirection })" aria-label="Page @i">
                                        @i
                                    </a>
                                </li>
                            }
                        }
                    }
                </ul>

                @if (Model.HasNextPage)
                {
                    <div class="govuk-pagination__next">
                        <a class="govuk-link govuk-pagination__link" href="@Url.Action("HeatNetworks", "UserManagement", new { pageNumber = Model.PageNumber + 1, pageSize = Model.PageSize, sortBy = Model.SortBy, sortDirection = Model.SortDirection })" rel="next">
                            <span class="govuk-pagination__link-title">Next</span>
                            <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                                <path d="m8.107-0.0078125-1.4136 1.414 4.2926 4.293h-12.986v2h12.896l-4.1855 3.9766 1.377 1.4492 6.7441-6.4062-6.7246-6.7266z"></path>
                            </svg>
                        </a>
                    </div>
                }
            </nav>
        }

    </div>
</div>