@using HNTAS.Api.Client.Model
@using HNTAS.Web.UI.Models

@model DashboardModel

@{
    ViewData["Title"] = "User Account";
    var disabled = Model.HasHeatNetworks ? "" : "dashboard-card--disabled";
    var userIsRP = Model.UserRole == UserRole.ResponsiblePerson.ToString();
    var userIsActingRP = Model.UserRole == UserRole.NetworkManager.ToString();
    var userIsAssessor = Model.UserRole == HNTAS.Api.Client.Model.UserRole.Assessor.ToString();
    var userIsCertifier = Model.UserRole == HNTAS.Api.Client.Model.UserRole.Certifier.ToString();
    var userIsContributor = Model.UserRole == HNTAS.Api.Client.Model.UserRole.Contributor.ToString();
    var userIsDesignatedDutyHolder = Model.UserRole == HNTAS.Api.Client.Model.UserRole.DesignatedDutyHolder.ToString();
    var newNetworksLabel = @ViewBag.IsExistingNetworksFeatureEnabled ? "Your heat networks (New build)" : "Your heat networks";
}

<div class="govuk-width-container">

    @if (Model.UserRole == UserRole.ResponsiblePerson.ToString() || Model.UserRole == UserRole.NetworkManager.ToString())
    {
        <span class="govuk-caption-l">Dashboard</span>
        <h1 class="govuk-heading-l">@Model.OrganisationName</h1>
    }
    else
    {
        <span class="govuk-caption-l">Dashboard</span>
        <h1 class="govuk-heading-l"></h1>
    }
    @if (userIsRP)
    {
        <div class="govuk-button-group govuk-!-margin-top-5">
            <span class="govuk-body">
                <a href="@Url.Action("Index", "HeatNetwork")" role="button" draggable="false" class="govuk-button" data-module="govuk-button">
                    Add a heat network
                </a>
                or
                <a class="govuk-link" href="@Url.Action("ManageLeads", "NetworkLeads")">Authorise someone else to add heat networks</a>
            </span>
        </div>
    }

    <div class="dashboard-grid">

        <!-- Your heat networks (new)-->
        @if (Model.HasHeatNetworks)
        {
            <div class="dashboard-grid__item">
                <div class="dashboard-card">
                    <h3 class="dashboard-card__title govuk-heading-s">
                        <a class="govuk-link govuk-link--no-visited-state" asp-action="HeatNetworks" asp-controller="UserManagement">@newNetworksLabel</a>
                    </h3>
                    <p class="govuk-body-s">View and add details to your heat network(s)</p>
                </div>
            </div>
        }

        @if (Model.HasHeatNetworks)
        {
            <div class="dashboard-grid__item">
                <div class="dashboard-card">
                    <h3 class="dashboard-card__title govuk-heading-s">
                        <a class="govuk-link govuk-link--no-visited-state" asp-action="ManageContributors" asp-controller="Contributors">Duty holders and contributors</a>
                    </h3>
                    <p class="govuk-body-s">Personnel providing expertise at a per network level only</p>
                </div>
            </div>
        }

        @if (userIsRP)
        {
            <!-- Network Managers -->
            @if (Model.HasHeatNetworks)
            {
                <div class="dashboard-grid__item">
                    <div class="dashboard-card">
                        <h3 class="dashboard-card__title govuk-heading-s">
                            @* <a class="govuk-link govuk-link--no-visited-state" asp-controller="NetworkLeads" asp-action="ManageLeads"> *@
                            <a class="govuk-link govuk-link--no-visited-state" asp-action="ManageLeads" asp-controller="NetworkLeads">
                                Network Managers
                            </a>
                        </h3>
                        <p class="govuk-body-s">Accountable personnel able to add heat networks and dutyholders</p>
                    </div>
                </div>
            }
        }

        @if ((userIsRP || userIsActingRP) && Model.HasHeatNetworks)
        {
            <div class="dashboard-grid__item">
                <div class="dashboard-card">
                    <h3 class="dashboard-card__title govuk-heading-s">
                        <a class="govuk-link govuk-link--no-visited-state" asp-action="Index" asp-controller="AssignedAssessor">Assessors</a>
                    </h3>
                    <p class="govuk-body-s">View assessors assigned to your networks</p>
                </div>
            </div>
        }

        <!-- Notifications -->
        <div class="dashboard-grid__item">
            <div class="dashboard-card">
                <h3 class="dashboard-card__title govuk-heading-s">
                    <a class="govuk-link govuk-link--no-visited-state" href="@Url.Action("Index", "Notification", new { userId = ViewBag.UserId })">
                        Notifications
                    </a>
                </h3>
                <p class="govuk-body-s">Network, element and personnel updates</p>
            </div>
        </div>

        <!-- Organisation Details -->
        <div class="dashboard-grid__item">
            <div class="dashboard-card">
                @if (Model.OrganisationName == null)
                {
                    <h3 class="dashboard-card__title govuk-heading-s">
                        <a class="govuk-link govuk-link--no-visited-state" asp-controller="ExistingOrganisation" asp-action="AddOrRegister">
                            Add Organisation Details
                        </a>
                    </h3>
                    <p class="govuk-body-s">Add or register the organisation you work for.</p>
                }
                else
                {
                    <h3 class="dashboard-card__title govuk-heading-s">
                        <a asp-controller="Dashboard" asp-action="OrganisationDetails" class="govuk-link govuk-link--no-visited-state">Organisation details</a>
                    </h3>
                    <p class="govuk-body-s">View or change your organisation's details.</p>
                }
            </div>
        </div>

        <!-- Your Details -->
        <div class="dashboard-grid__item">
            <div class="dashboard-card">
                <h3 class="dashboard-card__title govuk-heading-s">
                    <a class="govuk-link govuk-link--no-visited-state" asp-action="YourDetails" asp-controller="Dashboard">Your Details</a>
                </h3>
                <p class="govuk-body-s">View your details.</p>
            </div>
        </div>  

        
        @if (userIsRP || userIsActingRP)
        {
           
            @if (Model.HasOfgemNetworks && @ViewBag.IsExistingNetworksFeatureEnabled)
            {
                <div class="dashboard-grid__item">
                    <div class="dashboard-card">
                        <h3 class="dashboard-card__title govuk-heading-s">
                            <a class="govuk-link govuk-link--no-visited-state" asp-action="ExistingNetworks" asp-controller="UserManagement">Your heat networks (Existing build)</a>
                        </h3>
                        <p class="govuk-body-s">View and add details to your heat network(s)</p>
                    </div>
                </div>
            }            
            @if (@ViewBag.IsExistingNetworksFeatureEnabled)
            {
                <div class="dashboard-grid__item">
                    <div class="dashboard-card">
                        <h3 class="dashboard-card__title govuk-heading-s">
                            <a class="govuk-link govuk-link--no-visited-state" asp-action="Index" asp-controller="ImportExistingNetworks">Import Existing Networks</a>
                        </h3>
                        <p class="govuk-body-s">Search for active assessors using the fast typeahead proof-of-concept.</p>
                    </div>
                </div>
            }            

            @if (Model.HasHeatNetworks)
            {
                <div class="dashboard-grid__item">
                    <div class="dashboard-card">
                        <h3 class="dashboard-card__title govuk-heading-s">
                            <a class="govuk-link govuk-link--no-visited-state" asp-action="Index" asp-controller="KpiDashboard">
                                KPI Dashboard
                            </a>
                        </h3>
                        <p class="govuk-body-s">
                            View KPI assessments, performance thresholds, and data integrity checks for registered heat networks.
                        </p>
                    </div>
                </div>

                <environment names="local,dev">
                    <div class="dashboard-grid__item">
                        <div class="dashboard-card">
                            <h3 class="dashboard-card__title govuk-heading-s">
                                <a class="govuk-link govuk-link--no-visited-state" asp-action="Index" asp-controller="PowerBi">
                                    Power Bi Dashboard
                                </a>
                            </h3>
                            <p class="govuk-body-s">
                                View KPI assessments, performance thresholds, and data integrity checks for registered heat networks.
                            </p>
                        </div>
                    </div>

                    <div class="dashboard-grid__item">
                        <div class="dashboard-card">
                            <h3 class="dashboard-card__title govuk-heading-s">
                                <a class="govuk-link govuk-link--no-visited-state" target="_blank" href="https://app.powerbi.com/groups/me/reports/6d3202fb-a1e5-4167-989d-07fdbed7a9d7/72d9137f634e75ade019?experience=power-bi">
                                    Power Bi Dashboard (Open new window)
                                </a>
                            </h3>
                            <p class="govuk-body-s">
                                View KPI assessments, performance thresholds, and data integrity checks for registered heat networks.
                            </p>
                        </div>
                    </div>
                </environment>
            }            
                      
        }
        else if (userIsAssessor)
        {
            @if (Model.HasHeatNetworks)
            {
                <div class="dashboard-grid__item">
                    <div class="dashboard-card ">
                        <h3 class="dashboard-card__title govuk-heading-s">
                            <a class="govuk-link govuk-link--no-visited-state" asp-action="UserDetails" asp-controller="Assessor">User Details</a>
                        </h3>
                        <p class="govuk-body-s">View your details</p>
                    </div>
                </div>
            }
            

            @if (Model.HasHeatNetworks)
            {
                <div class="dashboard-grid__item">
                    <div class="dashboard-card">
                        <h3 class="dashboard-card__title govuk-heading-s">
                            <a class="govuk-link govuk-link--no-visited-state" asp-action="HeatNetworks" asp-controller="UserManagement">@newNetworksLabel</a>
                        </h3>
                        <p class="govuk-body-s">View the heat network to be assessed.</p>
                    </div>
                </div>
            }
                       
        }
        else if (userIsCertifier)
        {
            @if (Model.HasHeatNetworks)
            {
                <div class="dashboard-grid__item">
                    <div class="dashboard-card">
                        <h3 class="dashboard-card__title govuk-heading-s">
                            <a class="govuk-link govuk-link--no-visited-state" asp-action="UserDetails" asp-controller="Assessor">User Details</a>
                        </h3>
                        <p class="govuk-body-s">View your details</p>
                    </div>
                </div>
            }
            

            @if (Model.HasHeatNetworks)
            {
                <div class="dashboard-grid__item">
                    <div class="dashboard-card">
                        <h3 class="dashboard-card__title govuk-heading-s">
                            <a class="govuk-link govukpower-link--no-visited-state" asp-action="HeatNetworks" asp-controller="UserManagement">Networks for certification</a>
                        </h3>
                        <p class="govuk-body-s">View networks assigned to you.</p>
                    </div>
                </div>
            }
            
        }
        else if(userIsContributor || userIsDesignatedDutyHolder)
        {
            @if (Model.HasHeatNetworks)
            {
                <div class="dashboard-grid__item">
                    <div class="dashboard-card">
                        <h3 class="dashboard-card__title govuk-heading-s">
                            <a class="govuk-link govuk-link--no-visited-state" asp-action="HeatNetworks" asp-controller="UserManagement">@newNetworksLabel</a>
                        </h3>
                        <p class="govuk-body-s">View, add or edit heat network details.</p>
                    </div>
                </div>
            }
            
            @if (userIsDesignatedDutyHolder)
            {
                @if (Model.HasHeatNetworks)
                {
                    <div class="dashboard-grid__item">
                        <div class="dashboard-card">
                            <h3 class="dashboard-card__title govuk-heading-s">
                                <a class="govuk-link govuk-link--no-visited-state" asp-action="ManageContributors" asp-controller="Contributors">Contributors</a>
                            </h3>
                            <p class="govuk-body-s">Personnel providing expertise at a per network level only</p>
                        </div>
                    </div>
                }
                
            }
        }
        <environment names="dev">
            <!-- Carbon Calculator-->
            <div class="dashboard-grid__item">
                <div class="dashboard-card">
                    <h3 class="dashboard-card__title govuk-heading-s">
                        <a class="govuk-link govuk-link--no-visited-state" asp-action="Index" asp-controller="CarbonCalculator">Carbon Calculator</a>
                    </h3>
                    <p class="govuk-body-s">Calculate carbon emission for your heat network.</p>
                </div>
            </div>
        </environment>

    </div>


    
</div>