@using HNTAS.Web.UI.Models
@using HNTAS.Web.UI.Models.HeatNetworkRegistration
@using HNTAS.Web.UI.Models.Enums
@model DoesCommunalEcSupplyOneBlockViewModel

@{
    string controllerName = Convert.ToString(ViewBag.ControllerName) ?? string.Empty;
    ViewData["Title"] = "Is the heat network a single communal block – Certify your heat networks with the Heat Network Technical Assurance Scheme (HNTAS)";
    var fieldOrder = new[] { nameof(Model.SuppliesOneBlock) };
    var elementId = Html.GenerateIdFromName(nameof(Model.SuppliesOneBlock)).ToLowerInvariant();
    var pageData = new QuestionWithRadiobuttonsModel
    {
        Controller = controllerName,
        Action = "HeatNetworkCommunalOneBlock",
        FieldOrder = fieldOrder,
        Questions = new List<Question>
        {
            new Question
            {
                QId = elementId,
                QText = "Does this energy centre only supply this one communal building?",
                QDescText = null,
                QHintText = null,
                Options = new List<Option>
                {
                    new Option { OptId = $"{elementId}", OptValue = "true", OptText = "Yes", OptHintText = null },
                    new Option { OptId = $"{elementId}-2", OptValue = "false", OptText = "No", OptHintText = null }
                },
                SeletedOption = Model.SuppliesOneBlock.ToString().ToLowerInvariant()
            },
        }
    };
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <span class="govuk-caption-l">Add a heat network</span>
            @await Html.PartialAsync("_QuestionWithRadiobuttons", pageData)
        </div>
    </div>
</div>