@using HNTAS.Web.UI.Models.HeatNetworkRegistration
@using HNTAS.Api.Client.Model
@model HeatNetworkConnectionsViewModel

@{
    ViewData["Title"] = "Heat network summary";
    string controllerName = Convert.ToString(ViewBag.ControllerName) ?? string.Empty;
}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <span class="govuk-caption-l">Add a heat network</span>
        <h1 class="govuk-heading-l">
            Heat network summary
        </h1>

        <p class="govuk-body">You're registering a&nbsp;district heat network supplied by a separate upstream network</p>
        <p class="govuk-body">The main energy centre should be registered as a separate district network by that organisation.</p>
        <p class="govuk-body">Connected communal networks must be registered separately</p>

        <h2 class="govuk-heading-m">Connections</h2>

        <ul class="govuk-list govuk-list--bullet">
            @if (Model.ConnectionsToDisplay.Any())
            {
                foreach (var c in Model.ConnectionsToDisplay)
                {
                    <li>@c</li>
                }
            }                
        </ul>

        <button class="govuk-button" onclick="location.href='@Url.Action("HeatNetworkName", controllerName)'">
            Continue
        </button>
    </div>
</div>