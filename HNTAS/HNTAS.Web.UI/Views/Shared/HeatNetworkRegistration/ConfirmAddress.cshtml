@model HNTAS.Web.UI.Models.Address.AddressByStreetOrTownModel
@{
    ViewData["Title"] = "Confirm this is the right address";
    var Address = $@"
{Model.StreetAddress},
{Model.TownOrCity},
{Model.Postalcode}";
    string controllerName = Convert.ToString(ViewBag.ControllerName) ?? string.Empty;
}


<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

        <h1 class="govuk-heading-l">
            Is this the correct address?
        </h1>
        <div class="govuk-body govuk-!-margin-bottom-6">
            <pre class="govuk-body">
                @Address
            </pre>
        </div>  
        <p class="govuk-body">
            <a href="@Url.Action("DoesHNHaveAPostcode", controllerName)" class="govuk-link govuk-link--no-visited-state">Change</a>
        </p>

        <form asp-controller="@controllerName" asp-action="ConfirmAddress" method="post" novalidate>
            @Html.AntiForgeryToken()
            <button type="submit" class="govuk-button" data-module="govuk-button">
                Confirm and continue
            </button>
        </form>
    </div>
</div>