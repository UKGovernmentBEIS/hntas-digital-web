@{
    ViewData["Title"] = "Your organisation may not need to comply with the new regulations – Certify your heat networks with the Heat Network Technical Assurance Scheme (HNTAS)";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <span class="govuk-caption-l">Add a heat network</span>
        <h1 class="govuk-heading-l">
            Your organisation may not need to comply with the new regulations
        </h1>
        <p class="govuk-body">
            Based on your answers, your heat network may not fall within scope of the new HNTAS technical requirements.
        </p>
        <p class="govuk-body">However, you may still need to comply with Ofgem’s heat network regulations.</p>

        <p class="govuk-body">
            Review <a class="govuk-link" target="_blank" href="https://www.ofgem.gov.uk/energy-regulation/low-carbon/heat-networks">Ofgem regulations (opens in new tab)</a> to check whether you need to register your heat network or apply for authorisation.
        </p>
    </div>
</div>