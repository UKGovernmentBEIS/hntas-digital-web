@using HNTAS.Api.Client.Model
@using HNTAS.Web.UI.Models
@using HNTAS.Web.UI.Models.Review
@using HNTAS.Web.UI.Models.Components
@model CheckYourAnswersHeatNetworkModel

@{
    ViewData["Title"] = "Check your answers";
    string controllerName = Convert.ToString(ViewBag.ControllerName) ?? string.Empty;

    var viewModel = new ReviewSummaryModel
    {
        Sections = new List<ReviewSection>
        {
            new ReviewSection
            {
                Heading = "Heat Network registration",
                Items = new List<ReviewItem>
                {
                    new ReviewItem
                    {
                        Key = "Number of dwellings more than 6",
                        Value = Model.DoesHnHaveMoreThan6Dwellings,
                        ChangeLink = Url.Action("HeatNetworkDwellingsCheck", controllerName, new { hnid = ViewBag.HnId }),
                        ChangeLinkText = "Change"
                    },                    
                    new ReviewItem
                    {
                        Key = "Network Type",
                        Value = Model.HeatNetworkType,
                        ChangeLink = Url.Action("HeatNetworkType", controllerName),
                        ChangeLinkText = "Change"
                    },
                    new ReviewItem
                    {
                        Key = "Has own energy centre",
                        Value = Model.HasOwnEnergyCenter,
                        ChangeLink = ViewBag.RegistrationSource == RegistrationSource.OFGEM ? null :  Url.Action(Model.HeatNetworkType == "Communal" ? "HeatNetworkEcCommunal" : "HeatNetworkEcDistrict", controllerName),
                        ChangeLinkText = "Change"
                    },
                    new ReviewItem
                    {
                        Key = "Coordinates",
                        Value = Model.ECDetailsModel.LatitudeLongitude,
                        ChangeLink = ViewBag.RegistrationSource == RegistrationSource.OFGEM ? null : Url.Action("ECCoordinates", controllerName),
                        ChangeLinkText = "Change"
                    },
                    new ReviewItem
                    {
                        Key = "Heat Network Name",
                        Value = Model.HeatNetworkNameModel.HeatNetworkName,
                        ChangeLink = ViewBag.RegistrationSource == RegistrationSource.OFGEM ? null : Url.Action("HeatNetworkName", controllerName), 
                        ChangeLinkText = "Change"
                    },
                    new ReviewItem
                    {
                        Key = "Additional description",
                        Value = !string.IsNullOrEmpty(Model.HeatNetworkNameModel.AdditionalDescription) ? Model.HeatNetworkNameModel.AdditionalDescription : "Not provided",
                        ChangeLink = Url.Action("HeatNetworkName", controllerName),
                        ChangeLinkText = "Change"
                    },
                    new ReviewItem
                    {
                        Key = "Main energy centre address and postcode",
                        Value = Model.HeatNetworkAddressModel?.Fulladdress ?? "Not provided",
                        ChangeLink = ViewBag.RegistrationSource == RegistrationSource.OFGEM ? null : Url.Action("DoesHNHaveAPostcode", controllerName),
                        ChangeLinkText = "Change"
                    },
                    new ReviewItem
                    {
                        Key = "Phase",
                        Value = Model.HeatNetworkPhaseModel.HeatNetworkPhase,
                        ChangeLink = ViewBag.RegistrationSource == RegistrationSource.OFGEM ? null : Url.Action("HeatNetworkPhase", controllerName),
                        ChangeLinkText = "Change"
                    }

                }.Where(i => i != null).ToList()
            }
        }
    };
    @if (Model.HeatNetworkType == "District" && Model.HeatNetworkConnectionsModel.ConnectionsToDisplay.Any())
    {
        viewModel.Sections[0].Items.Insert(3, new ReviewItem
                {
                    Key = "Connections",
                    Value = string.Join(", ", Model.HeatNetworkConnectionsModel.ConnectionsToDisplay),
                    ChangeLink = Url.Action("HeatNetworkConnections", controllerName),
                    ChangeLinkText = "Change"
                });
    }
    
    var hasDeclarationErrors = ViewData.ModelState.ContainsKey(nameof(Model.ConfirmedDeclaration)) && ViewData.ModelState[nameof(Model.ConfirmedDeclaration)].Errors.Any();
    var confirmDeclarationComponentData = new ConfirmDeclarationCheckboxModel
    {
        Id = nameof(Model.ConfirmedDeclaration),
        Name = nameof(Model.ConfirmedDeclaration).ToLower(),
        Label = $"I confirm that the summary above is correct for {Model.HeatNetworkNameModel.HeatNetworkName}{(string.IsNullOrEmpty(Model.HeatNetworkNameModel.AdditionalDescription) ? "." : $", {Model.HeatNetworkNameModel.AdditionalDescription}.")}",
        HasError = hasDeclarationErrors,
        ErrorMessage = hasDeclarationErrors ? ViewData.ModelState[nameof(Model.ConfirmedDeclaration)].Errors[0].ErrorMessage : null,
        Value = Model.ConfirmedDeclaration
    };
}


<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">Check your answers</h1>
            <form asp-controller="@ViewBag.ControllerName" asp-action="SubmitAnswers" method="post" novalidate>
                @Html.AntiForgeryToken()
                @await Html.PartialAsync("Components/_CheckYourAnswersPartial", viewModel)

                <!-- Declaration -->
                @await Html.PartialAsync("Components/_ConfirmDeclaration", confirmDeclarationComponentData)

                <button type="submit" class="govuk-button" data-module="govuk-button">
                    Confirm
                </button>
            </form>
        </div>
    </div>        
</div>