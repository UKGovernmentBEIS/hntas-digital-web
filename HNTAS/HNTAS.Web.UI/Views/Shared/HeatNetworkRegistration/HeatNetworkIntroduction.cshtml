@{
    ViewData["Title"] = "Communal and district networks - Certify your heat networks with the Heat Network Technical Assurance Scheme (HNTAS)";
    string controllerName = Convert.ToString(ViewBag.ControllerName) ?? string.Empty;
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

        <span class="govuk-caption-l">Add a heat network</span>
        <h1 class="govuk-heading-l">
            Understanding communal and district networks
        </h1>

        <p class="govuk-body"><strong>Communal networks</strong> consist of the heat network elements that supply dwellings or units within one communal building.</p>

        <p class="govuk-body"><strong>District networks</strong> consist of the elements that supply more than one building, including the connecting elements between those buildings.</p>

        <div class="govuk-warning-text" data-module="govuk-warning-text" style="margin-top: 1.5rem;">
            <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
            <strong class="govuk-warning-text__text">
                <span class="govuk-warning-text__assistive govuk-visually-hidden">Warning</span>
                <span class="govuk-warning-text__message">
                    An energy centre within a communal building that also supplies other buildings must be registered as part of a district network.
                </span>
            </strong>
        </div>

        <div class="govuk-!-margin-top-6"></div>
        <form asp-controller="@controllerName" asp-action="HeatNetworkType" method="GET">
            <button type="submit" class="govuk-button govuk-button--start-green">
                Continue
            </button>
        </form>

    </div>
</div>