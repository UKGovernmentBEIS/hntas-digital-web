@{
    ViewData["Title"] = "You may need to register with HNTAS later";
}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <span class="govuk-caption-l">Add a heat network</span>
        <h1 class="govuk-heading-l">
            You may need to register with HNTAS later
        </h1>
        <p class="govuk-body">
            From your answers, your new heat network is in an operational stage, but not yet supplying customers.
        </p>
        <p>
            HNTAS is only supporting pre-operational networks at this time.
        </p>
        <p class="govuk-body">
            If your network is already supplying heat to consumers, you must be authorised by <a href="#" class="govuk-link">
                Ofgem
                <span class="govuk-visually-hidden">: find out about authorisation requirements</span>
            </a>
        </p><p class="govuk-body">
            You may now leave this service.
        </p>

    </div>
</div>