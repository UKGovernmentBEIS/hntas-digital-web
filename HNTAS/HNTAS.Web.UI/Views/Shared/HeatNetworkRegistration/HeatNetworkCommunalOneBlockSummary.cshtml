@{
    ViewData["Title"] = "Heat network summary";
    string controllerName = Convert.ToString(ViewBag.ControllerName) ?? string.Empty;
}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <span class="govuk-caption-l">Add a heat network</span>
        <h1 class="govuk-heading-l">
            Heat network summary
        </h1>
        <p class="govuk-body">
            Based on your answers, you're registering a communal heat network consisting of:
        </p>

        <ul class="govuk-list govuk-list--bullet">
            <li>1 communal building</li>
        </ul>

        <p class="govuk-body">
            This energy centre should not be registered with this communal building.
        </p>

        <p class="govuk-body">
            Register the energy centre as a part of a separate district network.
        </p>
        <button class="govuk-button" onclick="location.href='@Url.Action("HeatNetworkName", controllerName)'">
            Continue
        </button>
    </div>
</div>