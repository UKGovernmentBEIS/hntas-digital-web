@{
    ViewData["Title"] = "Confirmation";
}


<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <div class="govuk-panel govuk-panel--confirmation">
                <h1 class="govuk-panel__title">
                    Heat network successfully registered
                </h1>

                <div class="govuk-panel__body">
                    <span>@ViewBag.HNNameWithDescription</span><br />
                    UHNID <strong>@ViewBag.HnId</strong>
                </div>

            </div>
            <p class="govuk-body">We've:</p>
            <ul class="govuk-list govuk-list--bullet">
                <li>registered your heat network service under @ViewBag.HnName's organisation</li>
                <li>sent a confirmation email with the unique heat network ID (UHNID): @ViewBag.HnId</li>
            </ul>
            <p class="govuk-body">As the responsible party, you can now provide technical information on your heat network and add team members to help you.</p>

            <a class="govuk-button" role="button" draggable="false" asp-controller="ExistingHeatNetworkRegistration" asp-action="HeatNetworkSuccessRedirection">
                Continue
            </a>
        </div>        
    </div>
</div>