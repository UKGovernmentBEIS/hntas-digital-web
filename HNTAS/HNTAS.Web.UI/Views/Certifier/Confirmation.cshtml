
@{
    ViewData["Title"] = "Certificate sent";
}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

        <div class="govuk-panel govuk-panel--confirmation">
            <h1 class="govuk-panel__title">
                Certificate 1 has been sent
            </h1>
        </div>

        <div class="govuk-!-margin-top-6">
            <p class="govuk-body">You've sent the certificate 1 for <strong>@ViewBag.HeatNetworkName</strong>.</p>
            <p class="govuk-body">Duty holder and responsible party has been emailed.</p>
        </div>

        <p class="govuk-body">
            Return to <a class="govuk-link" href="@Url.Action("UserAccount", "Dashboard")">your account</a>.
        </p>
    </div>
</div>