@using static HNTAS.Web.UI.Controllers.KpiDashboardController
@model NetworkListViewModel

@section BeforeMain {
    <nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
        <ol class="govuk-breadcrumbs__list">
            <li class="govuk-breadcrumbs__list-item">
                @if (!ViewBag.isSuperUser)
                {
                    <a class="govuk-breadcrumbs__link" href="@Url.Action("UserAccount", "Dashboard")">Dashboard</a>
                }
                else
                {
                    <a class="govuk-breadcrumbs__link" href="@Url.Action("Index", "AdminDashboard")">Dashboard</a>
                }
               
            </li>
            <li class="govuk-breadcrumbs__list-item">
                KPI dashboard
            </li>
        </ol>
    </nav>
}

<div class="govuk-grid-row">
    @* Left Column: Filters *@
    <div class="govuk-grid-column-one-third">
        <form method="get">
            <div class="govuk-form-group">
                <label class="govuk-label govuk-!-font-weight-bold" for="search">Search networks</label>
                <input class="govuk-input" id="search" name="searchTerm" type="text" value="@Model.SearchTerm">
            </div>

            <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">

            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">Reporting Period</legend>

                    <div class="govuk-form-group govuk-!-margin-bottom-2">
                        <label class="govuk-label" for="month">Month</label>
                        <select class="govuk-select govuk-!-width-full" id="month" name="month">
                            <option value="">All months</option>
                            @foreach (var m in Model.Months)
                            {
                                <option value="@m.Key" selected="@(Model.SelectedMonth == m.Key ? "selected" : null)">
                                    @m.Value
                                </option>
                            }
                        </select>
                    </div>

                    <div class="govuk-form-group">
                        <label class="govuk-label" for="year">Year</label>
                        <select class="govuk-select govuk-!-width-full" id="year" name="year">
                            @foreach (var y in Model.AvailableYears)
                            {
                                <option value="@y" selected="@(Model.SelectedYear == y ? "selected" : null)">@y</option>
                            }
                        </select>
                    </div>
                </fieldset>
            </div>

            <button type="submit" class="govuk-button">Apply filters</button>

            <p class="govuk-body govuk-!-margin-top-2">
                <a href="@Url.Action("Index", "KpiDashboard")" class="govuk-link govuk-link--no-visited-state">
                    Reset all filters
                </a>
            </p>
        </form>
    </div>

    @* Right Column: Results Table *@
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">Heat Networks</h1>

        @if (Model.Networks.Any())
        {
            <table class="govuk-table">
                <thead class="govuk-table__head">
                    <tr class="govuk-table__row">
                        <th class="govuk-table__header">HNID</th>
                        <th class="govuk-table__header">Network Name</th>
                        <th class="govuk-table__header">Provider</th>
                        <th class="govuk-table__header">Data Period</th>
                    </tr>
                </thead>
                <tbody class="govuk-table__body">
                    @foreach (var network in Model.Networks)
                    {
                        <tr class="govuk-table__row">
                            <td class="govuk-table__cell">
                            @* Updated Link to use submissionId *@
                                <a href="@Url.Action("Details", new { submissionId = network.SubmissionId, month = Model.SelectedMonth, year = Model.SelectedYear })" class="govuk-link govuk-!-font-weight-bold">
                                @network.Hnid
                            </a>
                        </td>
                        <td class="govuk-table__cell">@network.Name</td>
                        <td class="govuk-table__cell">@network.Provider</td>
                        <td class="govuk-table__cell">@network.DataPeriod</td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <div class="govuk-inset-text">
                No heat network data is available for the selected period.
            </div>
        }
        @* GOV.UK Pagination Component *@
        @if (Model.TotalPages > 1)
        {
            <nav class="govuk-pagination" role="navigation" aria-label="results">
                @if (Model.CurrentPage > 1)
                {
                    <div class="govuk-pagination__prev">
                        <a class="govuk-link govuk-pagination__link" href="@Url.Action("Index", new { searchTerm = Model.SearchTerm, month = Model.SelectedMonth, year = Model.SelectedYear, page = Model.CurrentPage - 1 })" rel="prev">
                            <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                                <path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.0095-3.8031h11.027v-2.0406h-11.053l4.029-4.029z"></path>
                            </svg>
                            <span class="govuk-pagination__link-title">Previous</span>
                        </a>
                    </div>
                }

                <ul class="govuk-pagination__list">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="govuk-pagination__item @(i == Model.CurrentPage ? "govuk-pagination__item--current" : "")">
                            <a class="govuk-link govuk-pagination__link" href="@Url.Action("Index", new { searchTerm = Model.SearchTerm, month = Model.SelectedMonth, year = Model.SelectedYear, page = i })" aria-label="Page @i">
                                @i
                            </a>
                        </li>
                    }
                </ul>

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <div class="govuk-pagination__next">
                        <a class="govuk-link govuk-pagination__link" href="@Url.Action("Index", new { searchTerm = Model.SearchTerm, month = Model.SelectedMonth, year = Model.SelectedYear, page = Model.CurrentPage + 1 })" rel="next">
                            <span class="govuk-pagination__link-title">Next</span>
                            <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                                <path d="m8.107-0.0078125-1.4136 1.414 4.1856 4.1856h-11.565v2.0406h11.568l-4.1887 4.1887 1.414 1.414 6.7469-6.7469z"></path>
                            </svg>
                        </a>
                    </div>
                }
            </nav>
        }
    </div>
</div>