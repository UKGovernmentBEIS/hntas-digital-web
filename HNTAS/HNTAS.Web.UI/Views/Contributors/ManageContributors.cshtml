@using HNTAS.Web.UI.Models.Contributors
@model List<DDHAndContributorsListModel>

@{
    ViewData["Title"] = "DDH and contributors List View";
    var nextAction = ViewBag.WhoDoYouWantToAdd == "Contributors" ? "AddContributor" : "NewContributorRole";
}

@section BeforeMain {

    <nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
        <ol class="govuk-breadcrumbs__list">
            <li class="govuk-breadcrumbs__list-item">
                <a class="govuk-breadcrumbs__link" href="@Url.Action("UserAccount", "Dashboard")">Dashboard</a>
            </li>
            <li class="govuk-breadcrumbs__list-item">
                @ViewBag.WhoDoYouWantToAdd
            </li>
        </ol>
    </nav>
}

    <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <span class="govuk-caption-l">Your network team</span>

        <h1 class="govuk-heading-l">
            @ViewBag.WhoDoYouWantToAdd
        </h1>

        <a href="@Url.Action(nextAction, "Contributors")" role="button" draggable="false" class="govuk-button" data-module="govuk-button">
            Add a person
        </a>

        @if (Model.Count == 0)
        {
            <p class="govuk-body">
                You do not have anyone currently added to your organisation.
            </p>
        }
        else
        {
            <h2 class="govuk-heading-m">Current @ViewBag.WhoDoYouWantToAdd.ToLower()</h2>
            <table class="govuk-table">
                <thead class="govuk-table__head">
                    <tr class="govuk-table__row">
                        <th class="govuk-table__header" scope="col">Name</th>
                        <th class="govuk-table__header" scope="col">Heat Network</th>
                        <th class="govuk-table__header" scope="col">Role</th>
                        <th class="govuk-table__header" scope="col">Status</th>
                    </tr>
                </thead>
                <tbody class="govuk-table__body">
                    @foreach (var user in Model)
                    {
                        <tr class="govuk-table__row">
                            <td class="govuk-table__cell">@user.Name</td>
                            <td class="govuk-table__cell">@user.HeatNetwork</td>
                            <td class="govuk-table__cell">@user.Role</td>
                            <td class="govuk-table__cell">
                                <span class="govuk-tag @user.Status.CssClass">@user.Status.Text</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }


    </div>
       
    </div>
