
@{
    ViewData["Title"] = "Cannot assign Responsible Party (RP)";
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">
                A heat network organisation cannot have more than one RP
            </h1>

            <p class="govuk-body">
                You cannot assign more than one Responsible Party (RP) to the heat network organisation.
            </p>

            <p class="govuk-body">
                If you are trying to replace the RP on a later date, follow these steps:
            </p>

            <ol class="govuk-list govuk-list--number">
                <li>Assign the new RP Network Manager role.</li>
                <li>Replace the existing user as the RP on the date the change has to be effective.</li>
            </ol>

            <p class="govuk-body">
                You may now leave this service.
            </p>

        </div>
    </div>
</div>